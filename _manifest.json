{
  "manifest_version": 2,
  "id": "fraternity-z.mai-mylife",
  "name": "麦日常",
  "version": "1.0.0",
  "description": "让麦麦拥有持续生活、消息体验、低频联网见闻以及自己的书柜与创作",
  "author": {
    "name": "fraternity-z",
    "url": "https://github.com/fraternity-z/maibot-mylife"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.16",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.91.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "send.image",
    "chat.get_all_streams",
    "chat.get_stream_by_user_id",
    "chat.get_private_streams",
    "chat.get_stream_by_group_id",
    "chat.get_group_streams",
    "chat.open_session",
    "llm.generate",
    "llm.get_available_models",
    "message.get_by_id",
    "api.call",
    "maisaka.proactive.trigger",
    "config.get",
    "web.search",
    "web.fetch"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "urls": {
    "repository": "https://github.com/fraternity-z/maibot-mylife",
    "homepage": "https://github.com/fraternity-z/maibot-mylife",
    "documentation": "https://docs.mai-mai.org"
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "mailife.png",
      "fallback": "fish",
      "background": "#BFE3F2"
    }
  }
}
